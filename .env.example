# GoLogs environment configuration (PRD §15).
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored;
# this template is the only place these variables should be documented.

# Ollama endpoint. GoLogs never calls a cloud LLM — this must always point
# at a local Ollama instance (FR-12: fully offline).
OLLAMA_HOST=http://127.0.0.1:11434

# Which local model profile to use: `default` (llama3.1:8b-instruct-q4_K_M,
# ~4.9GB) or `light` (phi3.5:3.8b-mini-instruct-q4_K_M, ~2.2GB) -- see §11.1.
MODEL_PROFILE=default

# Soft cap (in tokens, approximated at ~4 chars/token) on how much of a
# single tool result is placed back into the model's context. Bounds
# context growth on cases with very large query results.
MAX_TOOL_RESULT_TOKENS=4000

# Root sandbox directory for uploaded evidence (EVTX files, memory images).
# All access is path-traversal-checked against this root -- see
# backend/app/core/fs_sandbox.py.
CASE_STORAGE_DIR=./data/cases

# SQLAlchemy connection string. SQLite is the only supported backend for
# this single-analyst, local-first tool -- see PRD §9 for why Postgres was
# deliberately rejected.
DB_URL=sqlite:///./data/copilot.db

# Comma-separated risk classes that execute without an analyst confirmation
# prompt. Only AUTO_APPROVE tools ever qualify -- REQUIRES_CONFIRMATION and
# DENY are never configurable here; see backend/app/orchestrator/permission_gate.py,
# which enforces the deny-list in code, independent of this setting.
AUTO_APPROVE_RISK_CLASSES=AUTO_APPROVE

# `standard` or `strict` -- controls pattern-match sensitivity of the
# InjectionScanner (PRD §11.4 step 2). `strict` trades a higher
# false-positive rate for higher recall on subtler injection attempts.
INJECTION_SCAN_STRICTNESS=standard

# Standard Python logging level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
